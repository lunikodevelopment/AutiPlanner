<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Routine data is sensitive household information. Never back it up. -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
