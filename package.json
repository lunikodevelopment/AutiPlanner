{
  "name": "autiplanner",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "description": "Accessibility-first routine planning contracts and integrations.",
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "corepack pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" typecheck",
    "test": "corepack pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" test",
    "test:ha": "python3 -m unittest discover -s tests -t .",
    "test:android": "cd apps/android && ./gradlew :app:testDebugUnitTest"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
